    def _banner_markdown(self) -> str:
        urls = [
            u.strip()
            for u in (
                self.config["banner_url"]
                or ""
            ).split(",")
            if u.strip()
        ]

        if not urls:
            return ""

        return (
            f"![]({random.choice(urls)})\n\n"
        )

    # ---------- рич-доставка ----------

    async def _rich_api(
        self,
        method: str,
        payload: dict,
    ):
        inline = getattr(
            self,
            "inline",
            None,
        )

        token = (
            getattr(
                getattr(
                    inline,
                    "bot",
                    None,
                ),
                "token",
                None,
            )
            or getattr(
                inline,
                "_token",
                None,
            )
        )

        if not token:
            for ns in (
                "elys.inline",
                "heroku.inline",
                "hikka.inline",
            ):
                try:
                    token = self._db.get(
                        ns,
                        "bot_token",
                        None,
                    )
                except Exception:
                    token = None

                if token:
                    break

        if not token:
            raise RuntimeError(
                "инлайн-бот недоступен"
            )

        async with self.session.post(
            f"https://api.telegram.org/bot{token}/{method}",
            json=payload,
            timeout=aiohttp.ClientTimeout(
                total=30
            ),
        ) as resp:

            data = await resp.json(
                content_type=None
            )

        if not data.get("ok"):
            raise RuntimeError(
                data.get(
                    "description",
                    "ошибка Bot API",
                )
            )

        return data.get("result")

    @loader.inline_handler()
    async def richinfo_inline_handler(
        self,
        query,
    ):
        words = str(
            getattr(
                query,
                "query",
                "",
            )
            or ""
        ).split()

        token = (
            words[-1]
            if words
            else ""
        )

        markdown = self._pending.get(
            token
        )

        if not markdown:
            return

        qid = getattr(
            query,
            "id",
            None,
        ) or getattr(
            getattr(
                query,
                "inline_query",
                None,
            ),
            "id",
            None,
        )

        await self._rich_api(
            "answerInlineQuery",
            {
                "inline_query_id": qid,
                "results": [
                    {
                        "type": "article",
                        "id": token,
                        "title": "RichInfo",
                        "input_message_content": {
                            "rich_message": {
                                "markdown": markdown
                            }
                        },
                    }
                ],
                "cache_time": 0,
                "is_personal": True,
            },
        )

    async def _send_rich(
        self,
        message,
        candidates: list,
    ) -> bool:

        if not self.config["rich"]:
            return False

        for markdown in candidates:
            token = uuid.uuid4().hex[:12]
            self._pending[token] = markdown

            try:
                if not getattr(
                    self.inline,
                    "init_complete",
                    True,
                ):
                    raise RuntimeError(
                        "инлайн-бот ещё не готов"
                    )

                username = (
                    getattr(
                        self.inline,
                        "bot_username",
                        None,
                    )
                    or (
                        await self.inline.bot.get_me()
                    ).username
                )

                results = await self._client.inline_query(
                    username,
                    f"{INLINE_KEY} {token}",
                )

                if not results:
                    raise RuntimeError(
                        "пустой ответ на inline-запрос"
                    )

                await results[0].click(
                    message.chat_id,
                    reply_to=getattr(
                        message,
                        "reply_to_msg_id",
                        None,
                    ),
                )

                try:
                    await message.delete()
                except Exception:
                    pass

                return True

            except Exception as e:
                self._last_error = (
                    f"{type(e).__name__}: {e}"
                )

                logger.warning(
                    "RichInfo: rich attempt failed: %s",
                    self._last_error,
                )

            finally:
                self._pending.pop(
                    token,
                    None,
                )

        return False

    # ---------- команды ----------

    async def _info(self, message):
        stats = await self._stats()
        rows = self._rows(stats)

        now_dt = _kyiv_now()

        template = (
            self.config["custom_message"]
            or ""
        ).strip()

        values = await self._info_values(
            stats,
            now_dt,
        )

        if template:
            body = _render(
                template,
                values,
            )
        else:
            table = "\n".join(
                f"| {k} | {v} |"
                for k, v in rows
            )

            body = (
                "## 🌌 Elys\n\n"
                f"> **{self._owner()}**\n\n"
                "| Параметр | Значение |\n"
                "|---|---|\n"
                f"{table}\n\n"
                "---\n\n"
                f"<footer>{now_dt:%d.%m.%Y %H:%M:%S}</footer>"
            )

        media = self._banner_markdown()

        if media:
            if self.config["quote_media"]:
                media = "\n".join(
                    "> " + line
                    for line in media.rstrip().splitlines()
                ) + "\n\n"

            if self.config["inverse_media"]:
                candidates = [
                    body.rstrip()
                    + "\n\n"
                    + media.lstrip(),
                    body,
                ]
            else:
                candidates = [
                    media
                    + body,
                    body,
                ]
        else:
            candidates = [body]

        if await self._send_rich(
            message,
            candidates,
        ):
            return

        plain = "\n".join(
            f"<b>{k}:</b> "
            f"{v.replace('`', '')}"
            for k, v in rows
        )

        await utils.answer(
            message,
            "🌌 <b>Elys</b>\n"
            f"<blockquote>{plain}</blockquote>",
        )

