    async def client_ready(self, client, db):
        self._client = client
        self._db = db
        self.session = aiohttp.ClientSession()
        self._me = await client.get_me()
        self._proc = psutil.Process(os.getpid())
        self._proc.cpu_percent(None)

    async def on_unload(self):
        await self.session.close()

    # ---------- данные ----------

    def _owner(self) -> str:
        me = self._me
        parts = [
            getattr(me, "first_name", None),
            getattr(me, "last_name", None),
        ]
        return " ".join(p for p in parts if p) or str(
            getattr(me, "id", "?")
        )

    def _uptime(self) -> str:
        seconds = int(time.time() - self._proc.create_time())
        days, rest = divmod(seconds, 86400)
        hours, rest = divmod(rest, 3600)
        mins, secs = divmod(rest, 60)

        return (
            (f"{days} д " if days else "")
            + f"{hours:02d}:{mins:02d}:{secs:02d}"
        )

    def _version(self) -> str:
        try:
            from .. import version

            raw = getattr(version, "__version__", None)
            ver = (
                ".".join(map(str, raw))
                if isinstance(raw, (tuple, list))
                else str(raw or "?")
            )
        except Exception:
            ver = "?"

        try:
            git = str(utils.get_git_hash() or "")[:7]
        except Exception:
            git = ""

        return f"`{ver}`" + (f" `#{git}`" if git else "")

    async def _stats(self) -> dict:
        await asyncio.sleep(0.3)

        rss = self._proc.memory_info().rss / 1024 / 1024

        try:
            modules = str(len(self.allmodules.modules))
        except Exception:
            modules = None

        return {
            "version": self._version(),
            "uptime": self._uptime(),
            "ram": f"{rss:.1f} MB",
            "cpu": f"{self._proc.cpu_percent(None):.1f}%",
            "python": platform.python_version(),
            "system": f"{platform.system()} {platform.release()}",
            "modules": modules,
        }

    def _rows(self, stats: dict) -> list:
        wanted = [
            f.strip().lower()
            for f in DEFAULT_FIELDS.split(",")
        ]

        return [
            (ROW_LABELS[f], stats[f])
            for f in wanted
            if f in ROW_LABELS and stats.get(f) is not None
        ]

    async def _weather(self) -> dict:
        result = {
            "weather": "?",
            "outdoor_temperature": "?",
            "weather_and_temperature": "?",
            "humidity": "?",
            "pressure": "?",
            "wind_speed": "?",
        }

        try:
            async with self.session.get(
                "https://wttr.in/Kyiv?format=j1",
                timeout=aiohttp.ClientTimeout(total=8),
                headers={
                    "User-Agent": "RichInfo/1.2"
                },
            ) as resp:
                if resp.status != 200:
                    return result

                data = await resp.json(
                    content_type=None
                )

            current = (
                data.get("current_condition") or [{}]
            )[0]

            desc = (
                current.get("weatherDesc") or [{}]
            )[0].get("value") or "?"

            temp = current.get(
                "temp_C",
                "?"
            )

            humidity = current.get(
                "humidity",
                "?"
            )

            pressure = current.get(
                "pressure",
                "?"
            )

            wind = current.get(
                "windspeedKmph",
                "?"
            )

            result.update(
                {
                    "weather": str(desc),
                    "outdoor_temperature": f"{temp} °C",
                    "weather_and_temperature": (
                        f"{desc}, {temp} °C"
                    ),
                    "humidity": f"{humidity}%",
                    "pressure": f"{pressure} hPa",
                    "wind_speed": f"{wind} km/h",
                }
            )

        except Exception as e:
            logger.debug(
                "RichInfo weather failed: %s",
                e,
            )

        return result

